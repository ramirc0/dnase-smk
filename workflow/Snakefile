include: "rules/filter.smk"
include: "rules/qc.smk"
include: "rules/peaks.smk"
include: "rules/footprints.smk"


def qc_files(sample):
    """Return the QC files of a sample.

    Parameters
    ----------
    sample : str
        Sample ID from the sheet.

    Returns
    -------
    list of str
        BAM stats and flagstats, bamcounts and preseq targets, plus insert
        sizes for paired-end-only samples.
    """
    qc = prefix(sample, "qc")
    files = [f"{qc}.{bam}.{ext}" for bam in BAMS for ext in ("stats.txt", "flagstat.json")]
    files += [f"{qc}.bamcounts.txt", f"{qc}.preseq_targets.txt"]
    if sample in PAIRED_ONLY:
        files += [f"{qc}.insert_sizes.tsv", f"{qc}.insert_sizes.svg"]
    return files


rule all:
    input:
        [qc_files(s) for s in SAMPLES],
        [hotspot3_calls(s) for s in SAMPLES],
        [footprint_files(s) for s in SAMPLES if SAMPLES[s]["footprints"]],
