
include: "rules/common.smk"
include: "rules/reference.smk"
include: "rules/align.smk"
include: "rules/filter.smk"
include: "rules/qc.smk"
include: "rules/peaks.smk"
include: "rules/footprints.smk"
include: "rules/report.smk"


# Seconds-long jobs, which would spend longer queued than running.
localrules:
    qc_summary,


def deliverables(sample):
    """Return the files `rule all` requests for a sample beyond the QC table.

    Parameters
    ----------
    sample : str
        Sample ID from the sheet.

    Returns
    -------
    list of str
        The nuclear BAM, hotspot3's calls and density, the footprints when
        the sample's sheet rows allow them, and the insert size plot of a
        paired-end-only sample.
    """
    files = [f"{prefix(sample, 'filter')}.nuclear.bam", f"{prefix(sample, 'hotspot3')}.normalized_density.bw"]
    files += hotspot3_calls(sample)
    if SAMPLES[sample]["footprints"]:
        files += footprint_files(sample)
    if sample in PAIRED_ONLY:
        files.append(f"{prefix(sample, 'qc')}.insert_sizes.svg")
    return files


rule all:
    input:
        f"{OUTDIR}/qc.tsv",
        f"{OUTDIR}/qc.svg",
        [deliverables(s) for s in SAMPLES],
